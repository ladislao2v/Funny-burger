  m_Name: Tutorial
  m_EditorClassIdentifier: Assembly-CSharp::Code.Configs.TutorialConfig
  <Recipe>k__BackingField: {fileID: 11400000, guid: a40998e05ed9af24da0be71379df2db6,
    type: 2}
  <WrongBurger>k__BackingField: 0600000007000000
  <Boxes>k__BackingField: 0700000006000000
  <WelcomeHint>k__BackingField:
    <Title>k__BackingField:
      Words:
      - Language: 0
        Word: WELCOME!
      - Language: 1
        Word: "\u0414\u041E\u0411\u0420\u041E \u041F\u041E\u0416\u0410\u041B\u041E\u0412\u0410\u0422\u042C!"
    <Description>k__BackingField:
      Words:
      - Language: 0
        Word: 'You are the chef of a burger joint! Move the chef with the joystick,
          cook burgers and serve clients. Follow the arrows: they show what to do
          next.'
      - Language: 1
        Word: "\u0422\u044B \u0448\u0435\u0444-\u043F\u043E\u0432\u0430\u0440 \u0431\u0443\u0440\u0433\u0435\u0440\u043D\u043E\u0439!
          \u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0439 \u043F\u043E\u0432\u0430\u0440\u043E\u043C
          \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0434\u0436\u043E\u0439\u0441\u0442\u0438\u043A\u0430,
          \u0433\u043E\u0442\u043E\u0432\u044C \u0431\u0443\u0440\u0433\u0435\u0440\u044B
          \u0438 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0439 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432.
          \u0421\u043B\u0435\u0434\u0443\u0439 \u0437\u0430 \u0441\u0442\u0440\u0435\u043B\u043A\u0430\u043C\u0438:
          \u043E\u043D\u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0443\u0442,
          \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435."
  <TrashHint>k__BackingField:
    <Title>k__BackingField:
      Words:
      - Language: 0
        Word: TRASH
      - Language: 1
        Word: "\u041C\u0423\u0421\u041E\u0420\u041A\u0410"
    <Description>k__BackingField:
      Words:
      - Language: 0
        Word: Oops, this burger is made wrong! Clients won't accept it. Throw it
          into the trash can.
      - Language: 1
        Word: "\u0423\u043F\u0441, \u044D\u0442\u043E\u0442 \u0431\u0443\u0440\u0433\u0435\u0440
          \u0441\u043E\u0431\u0440\u0430\u043D \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E!
          \u041A\u043B\u0438\u0435\u043D\u0442 \u0442\u0430\u043A\u043E\u0439 \u043D\u0435
          \u043F\u0440\u0438\u043C\u0435\u0442. \u0412\u044B\u0431\u0440\u043E\u0441\u0438
          \u0435\u0433\u043E \u0432 \u043C\u0443\u0441\u043E\u0440\u043A\u0443."
  <TableHint>k__BackingField:
    <Title>k__BackingField:
      Words:
      - Language: 0
        Word: TABLE
      - Language: 1
        Word: "\u0421\u0422\u041E\u041B"
    <Description>k__BackingField:
      Words:
      - Language: 0
        Word: You can put whatever is on your plate on the table and pick it up later.
          Put this hamburger on the table.
      - Language: 1
        Word: "\u041D\u0430 \u0441\u0442\u043E\u043B \u043C\u043E\u0436\u043D\u043E
          \u043E\u0442\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u043E, \u0447\u0442\u043E
          \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u0442\u0430\u0440\u0435\u043B\u043A\u0435,
          \u0438 \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u0437\u0436\u0435.
          \u041F\u043E\u043B\u043E\u0436\u0438 \u044D\u0442\u043E\u0442 \u0433\u0430\u043C\u0431\u0443\u0440\u0433\u0435\u0440
          \u043D\u0430 \u0441\u0442\u043E\u043B."
  <LoyaltyHint>k__BackingField:
    <Title>k__BackingField:
      Words:
      - Language: 0
        Word: LOYALTY
      - Language: 1
        Word: "\u041B\u041E\u042F\u041B\u042C\u041D\u041E\u0421\u0422\u042C"
    <Description>k__BackingField:
      Words:
      - Language: 0
        Word: Serve orders on time to keep clients happy. Happy clients leave tips,
          unhappy ones wait less and come less often. Watch the loyalty bar!
      - Language: 1
        Word: "\u041E\u0442\u0434\u0430\u0432\u0430\u0439 \u0437\u0430\u043A\u0430\u0437\u044B
          \u0432\u043E\u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B
          \u043A\u043B\u0438\u0435\u043D\u0442\u044B \u0431\u044B\u043B\u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B.
          \u0414\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
          \u0447\u0430\u0435\u0432\u044B\u0435, \u0430 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0435
          \u0436\u0434\u0443\u0442 \u043C\u0435\u043D\u044C\u0448\u0435 \u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
          \u0440\u0435\u0436\u0435. \u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u0448\u043A\u0430\u043B\u043E\u0439
          \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0438!"
  <LetsGoHint>k__BackingField:
    <Title>k__BackingField:
      Words:
      - Language: 0
        Word: Let's go!
      - Language: 1
        Word: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u043C!"
    <Description>k__BackingField:
      Words:
      - Language: 0
        Word: Now you're all set! Enjoy the game.
      - Language: 1
        Word: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u0433\u043E\u0442\u043E\u0432!
          \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0439 \u0438\u0433\u0440\u044B."
